{
  "name": "@shiodome47/sekisho-town",
  "version": "0.6.0",
  "description": "関所めぐりの町: 時代劇の城下町を走り回って関所をさがし、学びをくり返して通行手形に印を集めるゲームの土台。中身（コース）は @shiodome47/sekisho のものを入れ替えて使う",
  "keywords": [
    "gamification",
    "game",
    "learning",
    "sekisho",
    "edo",
    "canvas"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiodome47/sekisho-town.git"
  },
  "homepage": "https://github.com/shiodome47/sekisho-town#readme",
  "bugs": "https://github.com/shiodome47/sekisho-town/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./cast": {
      "types": "./dist/cast/index.d.ts",
      "import": "./dist/cast/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json",
    "./art/*.webp": "./art/town/*.webp"
  },
  "files": [
    "dist",
    "art/town/*.webp"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "dev": "vite --config examples/web/vite.config.ts",
    "build:demo": "vite build --config examples/web/vite.config.ts"
  },
  "peerDependencies": {
    "@shiodome47/sekisho": "^0.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@shiodome47/sekisho": "^0.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
